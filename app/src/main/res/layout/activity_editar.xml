<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <EditText android:id="@+id/etEditarNombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nombre" />
        <Spinner android:id="@+id/spEditarEspecie" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
        <EditText android:id="@+id/etEditarEdad" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Edad en años" android:inputType="number" />
        <CheckBox android:id="@+id/cbEditarVacunado" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Vacunado" />
        <Spinner android:id="@+id/spEditarEstado" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
        <EditText android:id="@+id/etEditarDescripcion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Descripción" android:minLines="3" />
        <Button android:id="@+id/btnActualizar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Guardar cambios" />
    </LinearLayout>
</ScrollView>