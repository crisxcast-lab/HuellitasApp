<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <EditText android:id="@+id/etNombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nombre" />
        <Spinner android:id="@+id/spEspecie" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
        <EditText android:id="@+id/etEdad" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Edad en años" android:inputType="number" />
        <CheckBox android:id="@+id/cbVacunado" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Vacunado" />
        <Spinner android:id="@+id/spEstado" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
        <EditText android:id="@+id/etDescripcion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Descripción" android:minLines="3" />
        <Button android:id="@+id/btnGuardar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Guardar mascota" />
    </LinearLayout>
</ScrollView>